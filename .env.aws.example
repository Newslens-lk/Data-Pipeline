# AWS Deployment — Pipeline Environment
# Copy to .env.aws and fill in. Used by MWAA / ECS, NOT for local dev.
#
# For local dev, keep using .env (with STORAGE_ENDPOINT pointing to MinIO).
# The containers auto-detect: if STORAGE_ENDPOINT is set -> MinIO mode,
# if not set -> real AWS S3 with IAM role credentials.

# --- Airflow Variables (set in MWAA UI or via CLI) ---
# deploy_target=aws
# ecs_cluster=newslens-pipeline
# ecs_subnets=["subnet-abc123","subnet-def456"]
# ecs_security_groups=["sg-abc123"]
# ecr_repo_prefix=123456789012.dkr.ecr.us-east-1.amazonaws.com
# ecs_task_role=arn:aws:iam::123456789012:role/newslens-ecs-task-role
# ecs_execution_role=arn:aws:iam::123456789012:role/newslens-ecs-execution-role

# --- Pipeline env (set as Airflow Variable "pipeline_env" JSON) ---
# {
#   "STORAGE_BUCKET": "newslens-pipeline-prod",
#   "MODEL_KEY": "models/bias-classifier-xgb/xgb_model.joblib",
#   "USE_MODAL": "false",
#   "EMBEDDING_MODEL": "intfloat/multilingual-e5-large",
#   "DB_HOST": "news-db.xxxxxx.us-east-1.rds.amazonaws.com",
#   "DB_PORT": "5432",
#   "DB_NAME": "news_pipeline",
#   "DB_USER": "news",
#   "DB_PASSWORD": "<from-secrets-manager>"
# }
#
# NOTE: No STORAGE_ENDPOINT in the AWS pipeline_env — that's the switch.
# When STORAGE_ENDPOINT is absent, containers use IAM role credentials
# to talk to real S3 instead of MinIO.

# --- RDS ---
NEWS_DB_HOST=news-db.xxxxxx.us-east-1.rds.amazonaws.com
NEWS_DB_PORT=5432
NEWS_DB_NAME=news_pipeline
NEWS_DB_USER=news
# NEWS_DB_PASSWORD comes from AWS Secrets Manager

# --- S3 ---
STORAGE_BUCKET=newslens-pipeline-prod

# --- LLM ---
ANTHROPIC_API_KEY=
