# Copy to .env and fill in. Never commit the real .env.

PIPELINE_ENV=dev

# LLM
ANTHROPIC_API_KEY=

# ML model locations
BIAS_MODEL_URI=s3://news-pipeline-models/bias-classifier/latest
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
SUMMARIZATION_MODEL=claude-sonnet-4-6

# Cloud credentials for local dev against real object storage (skip if using
# managed Airflow's built-in IAM-role-based access instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
